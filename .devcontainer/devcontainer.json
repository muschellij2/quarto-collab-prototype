{
  "name": "Quarto collaborative prototype",
  "image": "ghcr.io/rocker-org/devcontainer/r-ver:4",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {}
  },
  "postCreateCommand": "npm install && R -q -e 'if (!requireNamespace(\"renv\", quietly=TRUE)) install.packages(\"renv\")'",
  "forwardPorts": [5173, 3030, 4200],
  "portsAttributes": {
    "5173": { "label": "Collaborative editor", "onAutoForward": "openPreview" },
    "3030": { "label": "Automerge sync" },
    "4200": { "label": "Quarto preview" }
  }
}
